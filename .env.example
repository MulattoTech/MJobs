# Generate a private password with python -m cli.init_env before Compose startup.
# Never use this placeholder or commit the generated .env.
POSTGRES_PASSWORD=replace-with-private-generated-value

# Conservative durable worker ceilings; category limits are enforced in PostgreSQL.
MJOBS_SOURCE_COLLECTION_CONCURRENCY=2
MJOBS_COMPANY_DISCOVERY_CONCURRENCY=1
MJOBS_AI_CONCURRENCY=1
MJOBS_DOCUMENT_GENERATION_CONCURRENCY=1
MJOBS_APPLICATION_AUTOMATION_CONCURRENCY=1

# RQ worker console log level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
MJOBS_WORKER_LOG_LEVEL=WARNING

# Submission admission caps per profile: decimal integers from 0 through 10000.
# Hourly/daily count the rolling previous hour/24 hours; company is all-time.
# SUBMITTING, CONFIRMED, and SUBMISSION_UNCONFIRMED records consume the caps.
# Zero denies admission. Recreate Compose services with docker compose up -d
# after changing these settings; restart native processes to reload their environment.
# These limits apply to fixtures too and never enable external submissions.
MJOBS_SUBMISSION_HOURLY_LIMIT=3
MJOBS_SUBMISSION_DAILY_LIMIT=10
MJOBS_SUBMISSION_COMPANY_LIMIT=1

# In-app notifications only: 0 disables (default), 1 enables.
MJOBS_NOTIFICATIONS_ENABLED=0

# Browser session label for NEW applications only: lowercase letter followed by
# up to 31 lowercase letters, digits or hyphens; no Windows device names.
# Existing sessions stay pinned.
# Per-application isolation is preserved; this never selects an arbitrary host path.
MJOBS_BROWSER_PROFILE=default
