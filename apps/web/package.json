{
  "name": "mjobs-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "lint": "eslint src vite.config.ts scripts *.config.mjs && node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write src vite.config.ts scripts *.config.mjs",
    "format:check": "prettier --check scripts *.config.mjs",
    "quality:test": "node --test scripts/quality-checks.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.10",
    "@babel/eslint-parser": "8.0.7",
    "@testing-library/dom": "^10.4.2",
    "@types/jsdom": "^21.1.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.14.0",
    "jsdom": "^26.1.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "license": "Apache-2.0",
  "overrides": {
    "eslint@10.14.0": {
      "minimatch": "11.0.3"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.3"
    }
  }
}
