      "id": 1,
      "title": "FLEET ATLAS \u00b7 Native telemetry, not simulated productivity",
      "description": "",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
