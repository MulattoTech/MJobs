{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MulattoTech/MJobs/blob/main/feature-studio/schema.v1.json",
  "title": "Feature Development Studio specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "repository",
    "priority",
    "scope",
    "problem",
    "desired_outcome",
    "acceptance_criteria",
    "lifecycle",
    "execution"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^FS-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3",
        "P4",
        "P5",
        "P6"
      ]
    },
    "scope": {
      "enum": [
        "full",
        "frontend",
        "backend",
        "ai",
        "infrastructure",
        "discover"
      ]
    },
    "problem": {
      "type": "string",
      "minLength": 3
    },
    "desired_outcome": {
      "type": "string",
      "minLength": 3
    },
    "affected_systems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "validation_strategy": {
      "enum": [
        "unit-integration",
        "e2e",
        "regression",
        "risk-based"
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 3
          },
          "status": {
            "enum": [
              "NOT_RUN",
              "PASS",
              "FAIL",
              "PARTIAL"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "lifecycle": {
      "enum": [
        "DRAFT",
        "REVIEW",
        "APPROVED",
        "IMPLEMENTING",
        "VERIFIED",
        "CLOSED"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_execution_requested",
        "agent_execution_authorized",
        "spec_review_approved",
        "human_merge_review_required",
        "automated_main_push"
      ],
      "properties": {
        "agent_execution_requested": {
          "type": "boolean"
        },
        "agent_execution_authorized": {
          "type": "boolean"
        },
        "spec_review_approved": {
          "type": "boolean"
        },
        "human_merge_review_required": {
          "type": "boolean"
        },
        "automated_main_push": {
          "type": "boolean"
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
